# Copy this file to .env and replace every placeholder with a local value.
# Never commit the resulting .env file.

# Generate a private value with: python -c "import secrets; print(secrets.token_hex(32))"
LEARNMATE_JWT_SECRET_KEY=replace_with_a_private_random_value_of_at_least_32_characters

# Login duration in minutes.
LEARNMATE_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini is optional during local development; deterministic fallbacks remain available.
GEMINI_API_KEY=replace_with_your_gemini_api_key
LEARNMATE_GEMINI_MODEL_NAME=gemini-2.5-flash

# Maximum material upload size in bytes (10 MiB by default).
LEARNMATE_MAX_UPLOAD_SIZE_BYTES=10485760

# Maximum decoded PNG/JPEG size in pixels (25 megapixels by default).
LEARNMATE_MAX_IMAGE_PIXELS=25000000

# Local Tesseract language-data folder used for private image OCR.
# Windows example: C:\Program Files\Tesseract-OCR\tessdata
LEARNMATE_TESSDATA_PATH=replace_with_your_local_tessdata_directory
