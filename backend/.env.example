# Copy this file to .env and replace every placeholder with a local value.
# Never commit the resulting .env file.

# Generate a private value with: python -c "import secrets; print(secrets.token_hex(32))"
LEARNMATE_JWT_SECRET_KEY=replace_with_a_private_random_value_of_at_least_32_characters

# Login duration in minutes.
LEARNMATE_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini is optional during local development; deterministic fallbacks remain available.
GEMINI_API_KEY=replace_with_your_gemini_api_key
LEARNMATE_GEMINI_MODEL_NAME=gemini-2.5-flash

# Maximum material upload size in bytes (10 MiB by default).
LEARNMATE_MAX_UPLOAD_SIZE_BYTES=10485760

# Maximum decoded PNG/JPEG size in pixels (25 megapixels by default).
LEARNMATE_MAX_IMAGE_PIXELS=25000000

# Semantic-search abuse controls. Limits are enforced by the backend.
LEARNMATE_MAX_SEARCH_QUERY_CHARACTERS=4096
LEARNMATE_SEARCH_RATE_LIMIT_REQUESTS=10
LEARNMATE_SEARCH_RATE_LIMIT_WINDOW_SECONDS=10

# Maximum accepted cosine distance for retrieved evidence (lower is closer).
LEARNMATE_MAX_RETRIEVAL_COSINE_DISTANCE=0.8

# Optional local Tesseract language-data override used for private image OCR.
# Leave this commented out to use automatic discovery of common locations.
# If automatic discovery fails, uncomment it and use the folder containing
# eng.traineddata. Windows example:
# LEARNMATE_TESSDATA_PATH=C:\Program Files\Tesseract-OCR\tessdata
